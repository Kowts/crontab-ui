<!doctype html>
<html lang="<%= locale === 'pt' ? 'pt-PT' : 'en' %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('pageTitle') %></title>
<script src="js/theme.js"></script>
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="js/dataTables.min.js"></script>
<script src="js/dataTables.bootstrap5.min.js"></script>
<script src="vendor/cronstrue/cronstrue-i18n.min.js"></script>
<script src="script.js"></script>
<script id="crontabs-state" type="application/json"><%- crontabs %></script>
<script id="routes-state" type="application/json"><%- routes %></script>
<script id="env-state" type="application/json"><%- env %></script>
<script id="i18n-state" type="application/json"><%- messages %></script>
</head>
<body class="app-body">
<% const canManageJobs = ['operator', 'admin'].includes(currentRole); %>
<% const canRunJobs = ['executor', 'operator', 'admin'].includes(currentRole); %>
<% const isAdmin = currentRole === 'admin'; %>
<% const jobs = JSON.parse(crontabs); %>
<% const hasJobs = jobs.length > 0; %>
<% const hasUnsavedChanges = jobs.some(function(job) { return !job.saved; }); %>
<% function accessLabel(job) { if (job.permissions.write) return 'manageAndRun'; if (job.permissions.execute) return 'runOnly'; return 'viewOnly'; } %>
<%- include('navbar.ejs') -%>

<main class="app-shell">
  <div class="breadcrumb-lite"><%= t('administration') %> <span>/</span> <%= t('scheduledTasks') %></div>
  <header class="page-heading">
    <div>
      <h1><%= t('scheduledTasks') %></h1>
      <p><%= t('manageDescription') %></p>
    </div>
    <div class="page-actions">
      <button type="button" class="btn btn-outline-secondary" data-action="preview"><i class="bi bi-code-square me-1"></i> <%= t('previewCrontab') %></button>
      <% if (canManageJobs) { %>
        <button type="button" class="btn btn-primary" data-action="new-job"><i class="bi bi-plus-lg me-1"></i> <%= t('newTask') %></button>
      <% } %>
    </div>
  </header>

  <% if (isAdmin) { %>
    <section class="app-card" aria-labelledby="environment-heading">
      <div class="card-heading">
        <h2 id="environment-heading"><%= t('environmentVariables') %></h2>
        <button type="button" class="link-action" data-action="toggle-environment" id="environment-toggle"><%= t('edit') %></button>
      </div>
      <div class="card-body-app">
        <pre class="environment-readonly" id="environment-display"><%= t('environmentEmpty') %></pre>
      </div>
      <div class="card-body-app d-none" id="environment-editor">
        <textarea class="environment-editor" rows="3" id="env_vars" placeholder="<%= t('environmentPlaceholder') %>"></textarea>
      </div>
    </section>
  <% } %>

  <section class="app-card" aria-labelledby="jobs-heading">
    <div class="card-heading">
      <div>
        <h2 id="jobs-heading"><%= t('tasks') %> <span class="jobs-count"><%= t(jobs.length === 1 ? 'taskCount_one' : 'taskCount_other', { count: jobs.length }) %></span></h2>
      </div>
      <div class="jobs-toolbar">
        <% if (isAdmin) { %>
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t('importExport') %></button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><button type="button" class="dropdown-item" data-action="import-db"><i class="bi bi-box-arrow-in-down me-2"></i><%= t('importConfiguration') %></button></li>
              <li><a class="dropdown-item" href="<%= JSON.parse(routes).export %>"><i class="bi bi-box-arrow-up me-2"></i><%= t('exportConfiguration') %></a></li>
              <li><hr class="dropdown-divider"></li>
              <li><button type="button" class="dropdown-item" data-action="import-crontab"><i class="bi bi-arrow-down-circle me-2"></i><%= t('getFromCrontab') %></button></li>
            </ul>
          </div>
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false"><%= t('actions') %></button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><button type="button" class="dropdown-item" data-action="backup"><i class="bi bi-shield-plus me-2"></i><%= t('createBackup') %></button></li>
              <li><button type="button" class="dropdown-item" data-action="set-crontab"><i class="bi bi-cloud-arrow-up me-2"></i><%= t('publishToCrontab') %></button></li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>

    <% if (hasJobs) { %>
      <table class="table align-middle mb-0" id="main_table">
        <thead>
          <tr><th>#</th><th><%= t('name') %></th><th><%= t('command') %></th><th><%= t('schedule') %></th><th><%= t('access') %></th><th><%= t('lastModified') %></th><th></th></tr>
        </thead>
        <tbody>
          <% jobs.forEach(function(crontab, index){ %>
            <tr data-job-row data-id="<%= crontab._id %>" class="<%= crontab.stopped ? 'table-light' : '' %>">
              <td><%= index + 1 %></td>
              <td>
                <strong><%= crontab.name || crontab._id %></strong>
                <div class="job-meta">
                  <% if (crontab.stopped) { %><span class="job-state job-state-stopped" data-job-schedule-state><i class="bi bi-stop-circle-fill" aria-hidden="true"></i><%= t('disabled') %></span><% } %>
                  <% if (crontab.saved) { %><span class="job-state job-state-published"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><%= t('publishedToService') %></span><% } else { %><span class="job-state job-state-local"><i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i><%= t('localOnly') %></span><% } %>
                </div>
              </td>
              <td><code><%= crontab.command %></code></td>
              <td><span title="<%= crontab.next %>"><%= crontab.schedule %></span><small class="d-block text-muted"><%= crontab.human %></small></td>
              <td>
                <span class="job-access"><i class="bi bi-person-lock" aria-hidden="true"></i><%= t('owner') %>: <%= crontab.owner || t('adminOnly') %></span>
                <small class="d-block text-muted"><%= t(accessLabel(crontab)) %></small>
              </td>
              <td><%= dayjs(new Date(crontab.timestamp)).fromNow() %></td>
              <td class="text-end text-nowrap">
                <% if (!crontab.stopped && crontab.logging && crontab.logging !== 'false') { %>
                  <a class="btn btn-sm btn-log-stderr" title="<%= t('viewErrorLog') %>" aria-label="<%= t('viewErrorLog') %>" href="<%= JSON.parse(routes).logger + '?id=' + crontab._id %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-journal-text"></i></a>
                  <a class="btn btn-sm btn-log-stdout" title="<%= t('viewOutputLog') %>" aria-label="<%= t('viewOutputLog') %>" href="<%= JSON.parse(routes).stdout + '?id=' + crontab._id %>" target="_blank" rel="noopener noreferrer"><i class="bi bi-terminal"></i></a>
                <% } %>
                <% if (!crontab.stopped && canRunJobs) { %><button type="button" class="btn btn-sm btn-run" title="<%= t('runNow') %>" aria-label="<%= t('runNow') %>" data-action="run" data-id="<%= crontab._id %>"><i class="bi bi-play-fill"></i><span class="visually-hidden"><%= t('runNow') %></span></button><% } %>
                <% if (canManageJobs) { %>
                  <% if (!crontab.stopped) { %><button type="button" class="btn btn-sm btn-schedule-disable" title="<%= t('disableSchedule') %>" aria-label="<%= t('disableSchedule') %>" data-toggle-job data-action="stop" data-id="<%= crontab._id %>"><i class="bi bi-stop-fill"></i><span class="visually-hidden"><%= t('disableSchedule') %></span></button><% } else { %><button type="button" class="btn btn-sm btn-schedule-enable" title="<%= t('enableSchedule') %>" aria-label="<%= t('enableSchedule') %>" data-toggle-job data-action="start" data-id="<%= crontab._id %>"><i class="bi bi-power"></i><span class="visually-hidden"><%= t('enableSchedule') %></span></button><% } %>
                  <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('edit') %>" aria-label="<%= t('edit') %>" data-action="edit" data-id="<%= crontab._id %>"><i class="bi bi-pencil"></i><span class="visually-hidden"><%= t('edit') %></span></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary" title="<%= t('duplicate') %>" aria-label="<%= t('duplicate') %>" data-action="duplicate" data-id="<%= crontab._id %>"><i class="bi bi-copy"></i><span class="visually-hidden"><%= t('duplicate') %></span></button>
                  <button type="button" class="btn btn-sm btn-outline-danger" title="<%= t('delete') %>" aria-label="<%= t('delete') %>" data-action="delete-job" data-id="<%= crontab._id %>"><i class="bi bi-trash"></i><span class="visually-hidden"><%= t('delete') %></span></button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-calendar-plus"></i></div>
        <h3><%= t('noTasks') %></h3>
        <p><%= t('noTasksDescription') %></p>
        <div class="empty-state-actions">
          <% if (canManageJobs) { %><button type="button" class="btn btn-primary" data-action="new-job"><i class="bi bi-plus-lg me-1"></i><%= t('createFirstTask') %></button><% } %>
          <% if (isAdmin) { %><button type="button" class="btn btn-outline-secondary" data-action="import-db"><%= t('importConfiguration') %></button><% } %>
        </div>
      </div>
    <% } %>
    <footer class="jobs-footer">
      <span><i class="bi bi-record-fill me-1"></i> <%= t('localChanges') %>: <%= t(hasUnsavedChanges ? 'pendingPublication' : 'none') %></span>
      <% if (isAdmin && hasUnsavedChanges) { %><button type="button" class="btn btn-sm btn-primary" data-action="set-crontab"><i class="bi bi-cloud-arrow-up me-1"></i><%= t('reviewAndPublish') %></button><% } %>
      <span><%= t('localChangesHint') %></span>
    </footer>
  </section>
</main>
<%- include('popup.ejs') -%>
</body>
</html>
