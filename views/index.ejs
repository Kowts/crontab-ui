<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crontab UI — Tarefas agendadas</title>
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/dataTables.bootstrap5.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="js/dataTables.min.js"></script>
<script src="js/dataTables.bootstrap5.min.js"></script>
<script src="vendor/cronstrue/cronstrue-i18n.min.js"></script>
<script src="script.js"></script>
<script id="crontabs-state" type="application/json"><%- crontabs %></script>
<script id="routes-state" type="application/json"><%- routes %></script>
<script id="env-state" type="application/json"><%- env %></script>
</head>
<body class="app-body">
<% const canManageJobs = ['operator', 'admin'].includes(currentRole); %>
<% const canRunJobs = ['executor', 'operator', 'admin'].includes(currentRole); %>
<% const isAdmin = currentRole === 'admin'; %>
<% const jobs = JSON.parse(crontabs); %>
<% const hasJobs = jobs.length > 0; %>
<% const hasUnsavedChanges = jobs.some(function(job) { return !job.saved; }); %>
<%- include('navbar.ejs') -%>

<main class="app-shell">
  <div class="breadcrumb-lite">Administração <span>/</span> Tarefas agendadas</div>
  <header class="page-heading">
    <div>
      <h1>Tarefas agendadas</h1>
      <p>Gere os comandos, horários e a publicação no crontab.</p>
    </div>
    <div class="page-actions">
      <button type="button" class="btn btn-outline-secondary" data-action="preview"><i class="bi bi-code-square me-1"></i> Pré-visualizar crontab</button>
      <% if (canManageJobs) { %>
        <button type="button" class="btn btn-primary" data-action="new-job"><i class="bi bi-plus-lg me-1"></i> Nova tarefa</button>
      <% } %>
    </div>
  </header>

  <% if (isAdmin) { %>
    <section class="app-card" aria-labelledby="environment-heading">
      <div class="card-heading">
        <h2 id="environment-heading">Variáveis de ambiente</h2>
        <button type="button" class="link-action" data-action="toggle-environment">Editar</button>
      </div>
      <div class="card-body-app" id="environment-editor">
        <textarea class="environment-editor" rows="3" id="env_vars" placeholder="# Defina PATH, MAILTO e outras variáveis necessárias…"></textarea>
      </div>
    </section>
  <% } %>

  <section class="app-card" aria-labelledby="jobs-heading">
    <div class="card-heading">
      <div>
        <h2 id="jobs-heading">Tarefas <span class="jobs-count"><%= jobs.length %> <%= jobs.length === 1 ? 'tarefa' : 'tarefas' %></span></h2>
      </div>
      <div class="jobs-toolbar">
        <% if (isAdmin) { %>
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Importar / Exportar</button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><button type="button" class="dropdown-item" data-action="import-db"><i class="bi bi-box-arrow-in-down me-2"></i>Importar configuração</button></li>
              <li><a class="dropdown-item" href="<%= JSON.parse(routes).export %>"><i class="bi bi-box-arrow-up me-2"></i>Exportar configuração</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><button type="button" class="dropdown-item" data-action="import-crontab"><i class="bi bi-arrow-down-circle me-2"></i>Obter do crontab</button></li>
            </ul>
          </div>
          <div class="dropdown">
            <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Acções</button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li><button type="button" class="dropdown-item" data-action="backup"><i class="bi bi-shield-plus me-2"></i>Criar backup</button></li>
              <li><button type="button" class="dropdown-item" data-action="set-crontab"><i class="bi bi-cloud-arrow-up me-2"></i>Publicar no crontab</button></li>
            </ul>
          </div>
          <form id="import_form" enctype="multipart/form-data" action="<%= JSON.parse(routes).import %>" method="post" class="d-none">
            <input type="file" id="import_file" name="import_file" accept=".db"/>
          </form>
        <% } %>
      </div>
    </div>

    <% if (hasJobs) { %>
      <table class="table align-middle mb-0" id="main_table">
        <thead>
          <tr><th>#</th><th>Nome</th><th>Comando</th><th>Horário</th><th>Última alteração</th><th></th></tr>
        </thead>
        <tbody>
          <% jobs.forEach(function(crontab, index){ %>
            <tr class="<%= crontab.stopped ? 'table-light' : '' %>">
              <td><%= index + 1 %></td>
              <td>
                <strong><%= crontab.name || crontab._id %></strong>
                <% if (crontab.saved) { %><i class="bi bi-check-circle-fill text-success ms-1" title="Publicado"></i><% } else { %><i class="bi bi-exclamation-circle-fill text-warning ms-1" title="Alterações por publicar"></i><% } %>
              </td>
              <td><code><%= crontab.command %></code></td>
              <td><span title="<%= crontab.next %>"><%= crontab.schedule %></span><small class="d-block text-muted"><%= crontab.human %></small></td>
              <td><%= dayjs(new Date(crontab.timestamp)).fromNow() %></td>
              <td class="text-end text-nowrap">
                <% if (!crontab.stopped && crontab.logging && crontab.logging !== 'false') { %>
                  <a class="btn btn-sm btn-outline-secondary" title="stderr" href="<%= JSON.parse(routes).logger + '?id=' + crontab._id %>" target="_blank"><i class="bi bi-journal-text"></i></a>
                  <a class="btn btn-sm btn-outline-secondary" title="stdout" href="<%= JSON.parse(routes).stdout + '?id=' + crontab._id %>" target="_blank"><i class="bi bi-terminal"></i></a>
                <% } %>
                <% if (!crontab.stopped && canRunJobs) { %><button type="button" class="btn btn-sm btn-outline-secondary" data-action="run" data-id="<%= crontab._id %>"><i class="bi bi-play-fill"></i><span class="visually-hidden">Executar</span></button><% } %>
                <% if (canManageJobs) { %>
                  <% if (!crontab.stopped) { %><button type="button" class="btn btn-sm btn-outline-secondary" data-action="stop" data-id="<%= crontab._id %>"><i class="bi bi-pause-fill"></i><span class="visually-hidden">Pausar</span></button><% } else { %><button type="button" class="btn btn-sm btn-outline-secondary" data-action="start" data-id="<%= crontab._id %>"><i class="bi bi-play-fill"></i><span class="visually-hidden">Ativar</span></button><% } %>
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-action="edit" data-id="<%= crontab._id %>"><i class="bi bi-pencil"></i><span class="visually-hidden">Editar</span></button>
                  <button type="button" class="btn btn-sm btn-outline-secondary" data-action="duplicate" data-id="<%= crontab._id %>"><i class="bi bi-copy"></i><span class="visually-hidden">Duplicar</span></button>
                  <button type="button" class="btn btn-sm btn-outline-danger" data-action="delete-job" data-id="<%= crontab._id %>"><i class="bi bi-trash"></i><span class="visually-hidden">Apagar</span></button>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">
        <div class="empty-state-icon"><i class="bi bi-calendar-plus"></i></div>
        <h3>Ainda não existem tarefas</h3>
        <p>Crie a primeira tarefa ou importe uma configuração existente. Poderá rever as alterações antes de publicar no crontab.</p>
        <div class="empty-state-actions">
          <% if (canManageJobs) { %><button type="button" class="btn btn-primary" data-action="new-job"><i class="bi bi-plus-lg me-1"></i>Criar primeira tarefa</button><% } %>
          <% if (isAdmin) { %><button type="button" class="btn btn-outline-secondary" data-action="import-db">Importar configuração</button><% } %>
        </div>
      </div>
    <% } %>
    <footer class="jobs-footer">
      <span><i class="bi bi-record-fill me-1"></i> Alterações locais: <%= hasUnsavedChanges ? 'por publicar' : 'nenhuma' %></span>
      <% if (isAdmin) { %><span><a href="#" data-action="import-crontab">Obter do crontab</a><a href="#" data-action="set-crontab">Publicar</a></span><% } %>
    </footer>
  </section>
</main>
<%- include('popup.ejs') -%>
</body>
</html>
