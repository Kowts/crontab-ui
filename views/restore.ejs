<!doctype html>
<html lang="<%= locale === 'pt' ? 'pt-PT' : 'en' %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('pageTitle') %></title>
<link rel="icon" href="<%= JSON.parse(routes).root %>images/crontab-ui.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="<%= JSON.parse(routes).root %>images/crontab-ui.svg">
<script src="<%= JSON.parse(routes).root %>js/theme.js"></script>
<link href="<%= JSON.parse(routes).root %>css/bootstrap.min.css" rel="stylesheet">
<link href="<%= JSON.parse(routes).root %>css/bootstrap-icons.min.css" rel="stylesheet">
<link href="<%= JSON.parse(routes).root %>css/app.css" rel="stylesheet">
<script src="<%= JSON.parse(routes).root %>js/jquery.min.js"></script>
<script src="<%= JSON.parse(routes).root %>js/bootstrap.bundle.min.js"></script>
<script src="<%= JSON.parse(routes).root %>js/script.js"></script>
<script id="crontabs-state" type="application/json"><%- crontabs %></script>
<script id="routes-state" type="application/json"><%- routes %></script>
<script id="i18n-state" type="application/json"><%- messages %></script>
</head>
<body class="app-body">
<%- include('navbar.ejs') -%>
<% const jobs = JSON.parse(crontabs); %>
<main class="app-shell backup-preview">
  <div class="breadcrumb-lite"><%= t('administration') %> <span>/</span> <%= t('backups') %> <span>/</span> <%= t('detail') %></div>
  <header class="page-heading">
    <div><h1><%= t('backup') %></h1><p class="backup-filename"><i class="bi bi-archive me-2" aria-hidden="true"></i><%= db %></p></div>
    <a class="btn btn-outline-secondary" href="<%= JSON.parse(routes).root %>"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i><%= t('tasks') %></a>
  </header>
  <section class="app-card" aria-labelledby="backup-tasks-heading">
    <div class="card-heading">
      <div><h2 id="backup-tasks-heading"><%= t('backupContents') %> <span class="jobs-count"><%= t(jobs.length === 1 ? 'taskCount_one' : 'taskCount_other', { count: jobs.length }) %></span></h2><p><%= t('backupPreviewHint') %></p></div>
    </div>
    <% if (jobs.length) { %>
    <div class="table-responsive backup-table-scroll" role="region" aria-labelledby="backup-tasks-heading" tabindex="0">
      <table class="table align-middle mb-0 backup-table">
        <thead><tr><th scope="col"><%= t('name') %></th><th scope="col"><%= t('executionMode') %></th><th scope="col"><%= t('schedule') %></th><th scope="col"><%= t('status') %></th><th scope="col"><%= t('lastModified') %></th></tr></thead>
        <tbody>
        <% jobs.forEach(function(job) { const structured = job.execution_mode === 'structured'; const modified = new Date(job.timestamp); %>
          <tr>
            <th scope="row"><strong class="backup-task-name"><%= job.name || job._id %></strong><small class="backup-task-id"><%= job._id %></small></th>
            <td><span class="backup-mode"><i class="bi <%= structured ? 'bi-diagram-3' : 'bi-terminal' %> me-1" aria-hidden="true"></i><%= t(structured ? 'modeStructured' : 'modeCommand') %></span>
              <details class="backup-execution"><summary><%= t('detail') %></summary>
                <% if (structured) { %>
                  <code><%= job.structured_execution.script_path %></code>
                  <% if (job.structured_execution.arguments.length) { %><pre><%= JSON.stringify(job.structured_execution.arguments, null, 2) %></pre><% } %>
                <% } else { %><code><%= job.command %></code><% } %>
              </details>
            </td>
            <td><code class="backup-schedule"><%= job.schedule %></code></td>
            <td><span class="environment-state <%= job.stopped ? 'environment-state-disabled' : 'environment-state-enabled' %>"><%= t(job.stopped ? 'disabled' : 'active') %></span></td>
            <td class="backup-modified"><% if (!Number.isNaN(modified.getTime())) { %><time datetime="<%= modified.toISOString() %>"><%= modified.toLocaleString(locale === 'pt' ? 'pt-PT' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></time><% } else { %><span class="text-muted"><%= t('none') %></span><% } %></td>
          </tr>
        <% }); %>
        </tbody>
      </table>
    </div>
    <% } else { %><div class="empty-state"><i class="bi bi-archive empty-state-icon" aria-hidden="true"></i><h3><%= t('backupNoTasks') %></h3></div><% } %>
    <div class="backup-restore-notice"><i class="bi bi-info-circle" aria-hidden="true"></i><p><%= t('backupRestoreHint') %></p></div>
    <div class="backup-actions">
      <button type="button" class="btn btn-primary" data-action="restore-backup" data-db="<%= db %>"><i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i><%= t('restoreBackup') %></button>
      <button type="button" class="btn btn-outline-danger" data-action="delete-backup" data-db="<%= db %>"><i class="bi bi-trash me-1" aria-hidden="true"></i><%= t('deleteBackup') %></button>
    </div>
  </section>
</main>
<%- include('popup.ejs') -%>
</body>
</html>
