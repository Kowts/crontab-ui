<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crontab UI</title>
<link href="css/bootstrap.min.css" rel="stylesheet">
<link href="css/bootstrap-icons.min.css" rel="stylesheet">
<link href="css/app.css" rel="stylesheet">
<script src="js/jquery.min.js"></script>
<script src="js/bootstrap.bundle.min.js"></script>
<script src="script.js"></script>
<script id="crontabs-state" type="application/json"><%- crontabs %></script>
<script id="routes-state" type="application/json"><%- routes %></script>
<!-- Legacy bootstrap moved to public/js/script.js.
	var crontabs = [];
	var routes = [];
	document.addEventListener('DOMContentLoaded', function() {
		var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
		tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
		crontabs = JSON.parse('<%- crontabs.replace(/\\\\/g, "\\\\\\\\").replace(/\\\"/g,"\\\\\"").replace(/\'/g,"\\\'") %>');
		routes = JSON.parse('<%- routes %>');
	});
-->
</head>
<body class="app-body">
<%- include('navbar.ejs') -%>
<main class="app-shell">
  <div class="breadcrumb-lite">Administração <span>/</span> Backups <span>/</span> Detalhe</div>
  <header class="page-heading"><div><h1>Backup</h1><p><%= db %></p></div></header>
  <section class="app-card">
	<table class="table align-middle mb-0">
	<tr>
		<th>Id</th>
		<th></th>
		<th>Job</th>
		<th>Time</th>
		<th>Last Modified</th>
	</tr>
	<% var index = 1 %>
	<% JSON.parse(crontabs).forEach(function(crontab){ %>
		<% if (!crontab.stopped) { %>
			<tr>
		<% } else { %>
			<tr class="table-primary">
		<% } %>

				<td>
					<%= index %>.
					<% index += 1 %>
					<%= crontab._id %>
				</td>

				<td>
					<% if (crontab.name) { %>
					<a class="btn btn-sm" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= crontab.name %>"><i class="bi bi-info-circle"></i></a>
					<% } %>
				</td>
				<td><%= crontab.command %></td>
				<td><%= crontab.schedule %></td>
				<td><%= crontab.timestamp %></td>
			</tr>
	<% }); %>



	</table>
	<div class="card-body-app d-flex gap-2"><button type="button" class="btn btn-primary" data-action="restore-backup" data-db="<%= db %>"><i class="bi bi-arrow-counterclockwise me-1"></i> Restaurar backup</button><button type="button" class="btn btn-outline-danger" data-action="delete-backup" data-db="<%= db %>"><i class="bi bi-trash me-1"></i> Apagar backup</button></div>
  </section>
</main>
<%- include('popup.ejs') -%>
</body>
</html>
