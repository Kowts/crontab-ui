<!doctype html>
<html lang="<%= locale === 'pt' ? 'pt-PT' : 'en' %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= t('executionEnvironments') %> — Crontab UI</title>
<link rel="icon" href="<%= JSON.parse(routes).root %>images/crontab-ui.svg" type="image/svg+xml">
<script src="<%= JSON.parse(routes).root %>js/theme.js"></script>
<link href="<%= JSON.parse(routes).root %>css/bootstrap.min.css" rel="stylesheet">
<link href="<%= JSON.parse(routes).root %>css/bootstrap-icons.min.css" rel="stylesheet">
<link href="<%= JSON.parse(routes).root %>css/app.css" rel="stylesheet">
<script src="<%= JSON.parse(routes).root %>js/jquery.min.js"></script>
<script src="<%= JSON.parse(routes).root %>js/bootstrap.bundle.min.js"></script>
<script defer src="<%= JSON.parse(routes).root %>js/execution-environments.js"></script>
<script id="routes-state" type="application/json"><%- routes %></script>
<script id="i18n-state" type="application/json"><%- messages %></script>
</head>
<body class="app-body">
<%- include('navbar.ejs') -%>
<main class="app-shell">
  <div class="breadcrumb-lite"><%= t('administration') %> <span>/</span> <%= t('executionEnvironments') %></div>
  <header class="page-heading">
    <div>
      <h1><%= t('executionEnvironments') %></h1>
      <p><%= t('executionEnvironmentsDescription') %></p>
    </div>
    <div class="page-actions">
      <button type="button" class="btn btn-primary" id="environment-add"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i><%= t('addExecutionEnvironment') %></button>
    </div>
  </header>

  <section class="app-card" aria-labelledby="environments-heading">
    <div class="card-heading">
      <h2 id="environments-heading"><%= t('executionEnvironments') %></h2>
      <div class="d-flex flex-wrap gap-2">
        <label class="visually-hidden" for="environment-target-filter"><%= t('executionTarget') %></label>
        <select class="form-select form-select-sm" id="environment-target-filter"><option value=""><%= t('filterAll') %></option></select>
        <label class="visually-hidden" for="environment-runtime-filter"><%= t('environmentRuntime') %></label>
        <select class="form-select form-select-sm" id="environment-runtime-filter">
          <option value=""><%= t('filterAll') %></option>
          <option value="python"><%= t('runtimePython') %></option>
          <option value="node"><%= t('runtimeNode') %></option>
          <option value="bash"><%= t('runtimeBash') %></option>
          <option value="binary"><%= t('runtimeBinary') %></option>
        </select>
        <label class="visually-hidden" for="environment-enabled-filter"><%= t('status') %></label>
        <select class="form-select form-select-sm" id="environment-enabled-filter">
          <option value=""><%= t('environmentFilterAll') %></option>
          <option value="true"><%= t('environmentFilterEnabled') %></option>
          <option value="false"><%= t('environmentFilterDisabled') %></option>
        </select>
      </div>
    </div>
    <div class="card-body-app">
      <p id="environment-list-status" class="text-muted" role="status" aria-live="polite"></p>
      <div class="table-responsive">
        <table class="table align-middle mb-0" id="execution-environments-table">
          <thead><tr>
            <th scope="col"><%= t('name') %></th>
            <th scope="col"><%= t('environmentRuntime') %></th>
            <th scope="col"><%= t('executionTarget') %></th>
            <th scope="col"><%= t('executablePath') %></th>
            <th scope="col"><%= t('validationStatus') %></th>
            <th scope="col"><%= t('dependentTasks') %></th>
            <th scope="col"><%= t('status') %></th>
            <th scope="col"><span class="visually-hidden"><%= t('actions') %></span></th>
          </tr></thead>
          <tbody id="execution-environments-body"></tbody>
        </table>
      </div>
      <p id="environment-empty" class="text-muted mb-0" hidden><%= t('environmentNoItems') %></p>
      <div class="d-flex align-items-center justify-content-between mt-3">
        <span id="environment-page-status" class="small text-muted"></span>
        <div class="btn-group btn-group-sm" role="group" aria-label="<%= t('filters') %>">
          <button type="button" class="btn btn-outline-secondary" id="environment-page-prev" aria-label="<%= t('previous') %>" disabled><i class="bi bi-chevron-left" aria-hidden="true"></i></button>
          <button type="button" class="btn btn-outline-secondary" id="environment-page-next" aria-label="<%= t('next') %>" disabled><i class="bi bi-chevron-right" aria-hidden="true"></i></button>
        </div>
      </div>
    </div>
  </section>
</main>

<div class="modal fade" id="execution-environment-modal" tabindex="-1" aria-labelledby="environment-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
    <div class="modal-header">
      <div><h2 class="modal-title" id="environment-modal-title"><%= t('addExecutionEnvironment') %></h2><p class="modal-subtitle"><%= t('environmentPathHelp') %></p></div>
      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button>
    </div>
    <div class="modal-body">
      <div class="nav nav-pills gap-2 mb-4" role="tablist" aria-label="<%= t('executionEnvironments') %>">
        <button type="button" class="nav-link active" id="environment-tab-general" role="tab" aria-selected="true" aria-controls="environment-panel-general" data-environment-tab="general"><%= t('environmentGeneral') %></button>
        <button type="button" class="nav-link" id="environment-tab-execution" role="tab" aria-selected="false" aria-controls="environment-panel-execution" data-environment-tab="execution"><%= t('environmentExecution') %></button>
        <button type="button" class="nav-link" id="environment-tab-review" role="tab" aria-selected="false" aria-controls="environment-panel-review" data-environment-tab="review"><%= t('environmentReview') %></button>
      </div>
      <div id="environment-form-error" class="alert alert-danger py-2" role="alert" hidden></div>
      <section id="environment-panel-general" role="tabpanel" aria-labelledby="environment-tab-general" data-environment-panel="general">
        <div class="row g-3">
          <div class="col-md-7"><label class="form-label" for="environment-name"><%= t('name') %> *</label><input class="form-control" id="environment-name" maxlength="120" required></div>
          <div class="col-md-5"><label class="form-label" for="environment-code"><%= t('environmentCode') %> *</label><input class="form-control" id="environment-code" pattern="[a-z][a-z0-9-]{2,63}" maxlength="64" required></div>
          <div class="col-md-6"><label class="form-label" for="environment-runtime"><%= t('environmentRuntime') %> *</label><select class="form-select" id="environment-runtime"><option value="python"><%= t('runtimePython') %></option><option value="node"><%= t('runtimeNode') %></option><option value="bash"><%= t('runtimeBash') %></option><option value="binary"><%= t('runtimeBinary') %></option></select></div>
          <div class="col-md-6"><label class="form-label" for="environment-description"><%= t('description') %></label><input class="form-control" id="environment-description" maxlength="2000"></div>
          <div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="environment-enabled" checked><label class="form-check-label" for="environment-enabled"><%= t('environmentEnabled') %></label></div></div>
        </div>
      </section>
      <section id="environment-panel-execution" role="tabpanel" aria-labelledby="environment-tab-execution" data-environment-panel="execution" hidden>
        <div class="row g-3">
          <div class="col-md-6"><label class="form-label" for="environment-target"><%= t('executionTarget') %> *</label><select class="form-select" id="environment-target" required></select></div>
          <div class="col-12"><label class="form-label" for="environment-executable"><%= t('executablePath') %> *</label><input class="form-control font-monospace" id="environment-executable" placeholder="/opt/runtime/bin/python" required></div>
          <div class="col-12"><label class="form-label" for="environment-working-directory"><%= t('workingDirectory') %></label><input class="form-control font-monospace" id="environment-working-directory" placeholder="/opt/processes"></div>
          <div class="col-12"><p class="form-text mb-0"><%= t('environmentPathHelp') %></p></div>
          <div class="col-12 d-flex align-items-center gap-3"><button type="button" class="btn btn-outline-primary" id="environment-validate"><i class="bi bi-shield-check me-1" aria-hidden="true"></i><%= t('validateEnvironment') %></button><span id="environment-validation-result" class="small" role="status" aria-live="polite"></span></div>
        </div>
      </section>
      <section id="environment-panel-review" role="tabpanel" aria-labelledby="environment-tab-review" data-environment-panel="review" hidden>
        <dl class="row mb-3" id="environment-review-summary"></dl>
        <h3 class="h6"><%= t('dependentTasks') %> <span id="environment-task-count">0</span></h3>
        <ul class="list-group mb-3" id="environment-task-list"></ul>
        <p class="alert alert-warning mb-0"><%= t('environmentReviewWarning') %></p>
      </section>
    </div>
    <div class="modal-footer">
      <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cancel') %></button>
      <button type="button" class="btn btn-outline-secondary" id="environment-tab-back" hidden><%= t('back') %></button>
      <button type="button" class="btn btn-primary" id="environment-tab-next"><%= t('next') %></button>
      <button type="button" class="btn btn-primary" id="environment-save" hidden><%= t('saveEnvironment') %></button>
    </div>
  </div></div>
</div>
</body>
</html>
