<div class="modal fade" id="job" tabindex="-1" aria-labelledby="job-title" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><div><h2 class="modal-title" id="job-title"><%= t('newTask') %></h2><p class="modal-subtitle"><%= t('newTaskDescription') %></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button></div>
    <div class="modal-body">
      <div class="row g-3">
        <div class="col-md-7"><label class="form-label" for="job-name"><%= t('taskOptional') %></label><input type="text" class="form-control" id="job-name" placeholder="<%= t('taskNamePlaceholder') %>" maxlength="128"/></div>
        <div class="col-md-5"><label class="form-label"><%= t('status') %></label><div class="job-status"><%= t('active') %></div></div>
        <div class="col-12"><label class="form-label" for="job-command"><%= t('commandRequired') %> <span aria-hidden="true">*</span></label><textarea class="form-control" id="job-command" rows="3" placeholder="<%= t('commandPlaceholder') %>"></textarea></div>
      </div>
      <section class="schedule-section" aria-labelledby="schedule-heading">
        <h3 id="schedule-heading"><%= t('whenToRun') %></h3>
        <div class="schedule-presets">
          <button type="button" class="btn btn-outline-secondary" data-schedule="* * * * *"><%= t('everyMinute') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="*/5 * * * *"><%= t('everyFiveMinutes') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="@hourly"><%= t('hourly') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="@daily"><%= t('daily') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="@weekly"><%= t('weekly') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="@monthly"><%= t('monthly') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="0 0 1 1 *"><%= t('yearly') %></button><button type="button" class="btn btn-outline-secondary" data-schedule="@reboot"><%= t('atStartup') %></button>
        </div>
        <div class="schedule-preview"><span><%= t('cronExpression') %></span><code id="job-string">* * * * *</code></div>
        <p id="job-schedule-description" class="schedule-description" role="status" aria-live="polite"><%= t('scheduleDescriptionDefault') %></p>
        <div class="row g-2 mt-2" aria-label="<%= t('customiseCron') %>">
          <div class="col"><label class="form-label schedule-part-label" for="job-minute"><%= t('minute') %></label><input type="text" class="form-control schedule-part" id="job-minute" value="*"/></div><div class="col"><label class="form-label schedule-part-label" for="job-hour"><%= t('hour') %></label><input type="text" class="form-control schedule-part" id="job-hour" value="*"/></div><div class="col"><label class="form-label schedule-part-label" for="job-day"><%= t('day') %></label><input type="text" class="form-control schedule-part" id="job-day" value="*"/></div><div class="col"><label class="form-label schedule-part-label" for="job-month"><%= t('month') %></label><input type="text" class="form-control schedule-part" id="job-month" value="*"/></div><div class="col"><label class="form-label schedule-part-label" for="job-week"><%= t('week') %></label><input type="text" class="form-control schedule-part" id="job-week" value="*"/></div><div class="col-auto align-self-end"><button type="button" class="btn btn-outline-secondary" id="set-schedule"><%= t('apply') %></button></div>
        </div>
      </section>
      <div class="job-options"><div class="form-check"><input type="checkbox" class="form-check-input" id="job-logging"/><label class="form-check-label" for="job-logging"><%= t('logErrors') %></label></div><div class="form-text"><%= t('mailProfilesManaged') %></div></div>
    </div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cancel') %></button><button type="button" class="btn btn-primary" id="job-save"><%= t('saveTask') %></button></div>
  </div></div>
</div>

<div class="modal fade" id="popup" tabindex="-1" aria-labelledby="modal-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="modal-title"><%= t('actions') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button></div><div class="modal-body" id="modal-body"></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="modal-close-button"><%= t('cancel') %></button><button type="button" class="btn btn-primary" id="modal-button"><%= t('actions') %></button></div></div></div></div>

<div class="modal fade" id="info-popup" tabindex="-1" aria-labelledby="info-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="info-title"><%= t('actions') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button></div><div class="modal-body" id="info-body"></div><div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="info-button"><%= t('close') %></button></div></div></div></div>

<div class="modal fade" id="import-modal" tabindex="-1" aria-labelledby="import-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="import_form" enctype="multipart/form-data" action="<%= JSON.parse(routes).import %>" method="post"><div class="modal-header"><div><h2 class="modal-title" id="import-title"><%= t('importTitle') %></h2><p class="modal-subtitle"><%= t('importBody') %></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button></div><div class="modal-body"><label class="form-label" for="import_file"><%= t('selectFile') %></label><input class="form-control" type="file" id="import_file" name="import_file" accept=".db" required><label class="form-label mt-3" for="import_mode"><%= t('importMode') %></label><select class="form-select" id="import_mode" name="mode"><option value="merge"><%= t('importMerge') %></option><option value="replace"><%= t('importReplace') %></option></select><p class="form-text mb-0" id="import-mode-help"><%= t('importMergeHint') %></p></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cancel') %></button><button type="submit" class="btn btn-primary"><%= t('reviewImport') %></button></div></form></div></div></div>

<div class="modal fade" id="import-preview-modal" tabindex="-1" aria-labelledby="import-preview-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><div><h2 class="modal-title" id="import-preview-title"><%= t('importPreviewTitle') %></h2><p class="modal-subtitle" id="import-preview-description"><%= t('importPreviewBody') %></p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button></div><div class="modal-body"><dl class="row mb-0" id="import-preview-summary"></dl></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cancel') %></button><button type="button" class="btn btn-primary" id="import-confirm"><%= t('importConfirmMerge') %></button></div></div></div></div>

<div class="modal fade" id="preview-crontab-modal" tabindex="-1" aria-labelledby="preview-crontab-title" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title" id="preview-crontab-title"><%= t('previewCrontab') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('close') %>"></button></div><div class="modal-body"><pre id="preview-crontab-content" class="bg-dark text-light p-3 rounded mb-0" style="min-height:200px;white-space:pre-wrap;word-break:break-all;font-size:0.875rem;"></pre></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" id="copy-crontab"><i class="bi bi-clipboard me-1"></i>Copy</button><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('close') %></button></div></div></div></div>
