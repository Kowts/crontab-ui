<!-- Job -->
<div class="modal fade" id="job" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="job-title">Job</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="job-body">
	<label class="form-label">Name (Optional)</label>
	<input type='text' class='form-control' id='job-name'/><br />
	<label class="form-label">Command</label>
	<textarea class='form-control' id='job-command' rows='3'></textarea><br />
	<label class="form-label">Quick Schedule</label><br />
	<div class="d-flex flex-wrap gap-2 mb-3">
		<button type="button" class="btn btn-primary btn-sm" data-schedule="* * * * *">Every Minute</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="*/5 * * * *">Every 5 Min</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="@hourly">Hourly</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="@daily">Daily</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="@weekly">Weekly</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="@monthly">Monthly</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="@yearly">Yearly</button>
		<button type="button" class="btn btn-primary btn-sm" data-schedule="@reboot">Startup</button>
	</div>

	<div class="row">
		<div class="col-md-2">Minute</div>
		<div class="col-md-2">Hour</div>
		<div class="col-md-2">Day</div>
		<div class="col-md-2">Month</div>
		<div class="col-md-2">Week</div>
	</div>
	<div class="row">
		<div class="col-md-2"><input type="text" class="form-control schedule-part" id="job-minute" value="*"/></div>
		<div class="col-md-2"><input type="text" class="form-control schedule-part" id="job-hour" value="*"/></div>
		<div class="col-md-2"><input type="text" class="form-control schedule-part" id="job-day" value="*"/></div>
		<div class="col-md-2"><input type="text" class="form-control schedule-part" id="job-month" value="*"/></div>
		<div class="col-md-2"><input type="text" class="form-control schedule-part" id="job-week" value="*"/></div>
		<div class="col-md-2"><button type="button" class="btn btn-primary btn-sm" id="set-schedule">Set</button></div>
	</div>

	<br />
	<br />
	<label class="form-label">Job</label>
	<input type='text' class='form-control' id='job-string' disabled='disabled'/><br />
	<div class="form-check">
		<input type="checkbox" class="form-check-input" id="job-logging"/>
		<label class="form-check-label" for="job-logging">Enable error logging.</label>
	</div>
	<br/>
	<span class="text-muted">Mail profiles are configured by the server administrator.</span>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="job-save">Save</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modal-title">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="modal-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="modal-close-button">Close</button>
        <button type="button" class="btn btn-primary" id="modal-button">Ok</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="info-popup" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="info-title">Message</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="info-body">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="info-button">Ok</button>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="preview-crontab-modal" tabindex="-1">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-code-square"></i> Crontab Preview</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3"><i class="bi bi-exclamation-triangle"></i> This is a preview of what will be deployed. It may differ from the currently active crontab if you have unsaved changes.</div>
        <pre id="preview-crontab-content" class="bg-dark text-light p-3 rounded" style="min-height:200px;white-space:pre-wrap;word-break:break-all;font-size:0.875rem;"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" id="copy-crontab"><i class="bi bi-clipboard"></i> Copy</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
