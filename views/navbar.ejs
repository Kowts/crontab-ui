<% const displayRole = typeof currentRole === 'undefined' ? 'viewer' : currentRole; %>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar">
  <div class="container-fluid app-shell py-0">
    <a class="navbar-brand" href="<%= JSON.parse(routes).root %>">Crontab UI</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Abrir menu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav ms-lg-5 me-auto">
        <li class="nav-item"><a class="nav-link active" href="<%= JSON.parse(routes).root %>">Tarefas</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Backups</a>
          <ul class="dropdown-menu">
            <% if (backups.length === 0){ %>
              <li><span class="dropdown-item-text text-muted">Sem backups disponíveis</span></li>
            <% } else { %>
              <% backups.forEach(function(file){ %>
                <li><a class="dropdown-item" href="<%= JSON.parse(routes).restore %>?db=<%= file %>"><%= file %></a></li>
              <% }) %>
            <% } %>
          </ul>
        </li>
      </ul>
      <div class="app-user text-capitalize"><%= displayRole %></div>
    </div>
  </div>
</nav>
