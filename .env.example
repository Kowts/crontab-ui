# Copy this file to `.env` for local use. Never commit files containing real secrets.
# Replace every example secret before enabling authentication, email, or production mode.

# -----------------------------------------------------------------------------
# Application runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8000
ALLOW_HTTP=false

# -----------------------------------------------------------------------------
# Authentication and roles
# -----------------------------------------------------------------------------
# Configure exactly one credential mechanism. The JSON user map takes precedence
# if both it and the single-user variables below are present.
#
# BASIC_AUTH_USER=administrator
# BASIC_AUTH_PWD=replace-with-a-strong-password
BASIC_AUTH_USERS_JSON={"administrator":"replace-with-a-strong-password","operator":"replace-with-another-strong-password","auditor":"replace-with-a-third-strong-password"}
# Prefer a scrypt digest over a literal password: run `npx crontab-ui-hash` and store the digest.
# A literal password is only acceptable for loopback development.

# Every configured user requires one role: viewer, executor, operator, or admin.
# Operators remain unable to manage task commands unless explicitly enabled below.
AUTHZ_ROLE_MAP_JSON={"administrator":"admin","operator":"operator","auditor":"viewer"}

# Required in production. Generate a long, random, persistent value.
CSRF_SECRET=replace-with-a-long-random-value

# Optional. A dedicated secret lets you rotate session signing independently.
# If omitted, CSRF_SECRET is used to sign sessions.
# AUTH_SESSION_SECRET=replace-with-a-different-long-random-value

# Session duration in milliseconds: default 28800000 (8 hours), minimum 60000,
# maximum 604800000 (7 days).
AUTH_SESSION_TTL_MS=28800000

# Failed POST /login attempts per source IP. Successful sign-ins do not count.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# Task execution and operational limits
# -----------------------------------------------------------------------------
COMMAND_TIMEOUT_MS=300000
COMMAND_MAX_BUFFER=1048576
COMMAND_KILL_GRACE_MS=5000

# Only allow reviewed variables to reach task processes. Process credentials and
# unsafe loader variables are never inherited.
TASK_ENV_ALLOWLIST=PATH,LANG,LC_ALL,TZ,MAILTO

# Operators can create and execute arbitrary task commands only when true.
# Keep false until task processes and accessible files are effectively isolated.
ALLOW_OPERATOR_TASK_EXECUTION=false

# -----------------------------------------------------------------------------
# Logs, backups, and system-crontab import
# -----------------------------------------------------------------------------
LOG_MAX_BYTES=10485760
LOG_ROTATION_COUNT=5
LOG_RETENTION_DAYS=30
# Execution history per task, in records, on top of the log retention window above.
EXECUTION_HISTORY_PER_JOB=200

BACKUP_RETENTION_COUNT=30
BACKUP_RETENTION_DAYS=90

# Bounds `crontab -l` when importing the system crontab. Import is serialised
# with backup and restore operations.
SYSTEM_CRONTAB_IMPORT_TIMEOUT_MS=30000
SYSTEM_CRONTAB_IMPORT_MAX_BUFFER=262144

# -----------------------------------------------------------------------------
# Optional email notifications
# -----------------------------------------------------------------------------
# JSON keyed by profile ID. SMTP credentials stay server-side and recipients are
# fixed by the profile. Remove the leading # only after replacing all examples.
# MAIL_PROFILES_JSON={"operations":{"transporter":"smtps://user:password@smtp.example.com","from":"crontab@example.com","to":"operations@example.com"}}
# Every profile is validated at startup; an invalid profile blocks the service from starting.
# Per-output attachment limit. Larger output is attached truncated; the alert is still sent.
MAIL_MAX_ATTACHMENT_BYTES=524288

# -----------------------------------------------------------------------------
# Docker Compose and reverse proxy
# -----------------------------------------------------------------------------
# Docker Compose only: stable internal network shared with the reverse proxy.
CRONTAB_UI_NETWORK=crontab-ui-internal

# Production deployments need TLS or a correctly configured TRUSTED_PROXY by default.
# ALLOW_HTTP=true explicitly permits unencrypted HTTP, including session cookies.
# Use only on an isolated, approved internal network; authentication and CSRF remain required.
# For direct HTTP, leave TRUSTED_PROXY unset rather than simulating an HTTPS proxy.
# See README.md for the deployment example and proxy guidance.
