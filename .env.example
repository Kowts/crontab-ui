# Never commit the real .env file.
BASIC_AUTH_USER=administrator
BASIC_AUTH_PWD=change-me
# For more than one operator, use this instead of BASIC_AUTH_USER/BASIC_AUTH_PWD.
BASIC_AUTH_USERS_JSON={"administrator":"change-me","operator":"change-me-too","auditor":"change-me-again"}
# Roles: viewer, operator and admin. Every authenticated user needs an explicit role.
AUTHZ_ROLE_MAP_JSON={"administrator":"admin","operator":"operator","auditor":"viewer"}
CSRF_SECRET=replace-with-a-long-random-value
# JSON object keyed by profile ID. Credentials remain server-side.
MAIL_PROFILES_JSON={"operations":{"transporter":"smtps://user:password@smtp.example.com","from":"crontab@example.com","to":"operations@example.com"}}
COMMAND_TIMEOUT_MS=300000
COMMAND_MAX_BUFFER=1048576
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_RETENTION_DAYS=90
