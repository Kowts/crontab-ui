# Never commit the real .env file.
BASIC_AUTH_USER=administrator
BASIC_AUTH_PWD=change-me
# Login credentials. For more than one user, use this instead of BASIC_AUTH_USER/BASIC_AUTH_PWD.
# If both mechanisms are configured, this map takes precedence.
BASIC_AUTH_USERS_JSON={"administrator":"change-me","operator":"change-me-too","auditor":"change-me-again"}
# Roles: viewer, operator and admin. Every authenticated user needs an explicit role.
AUTHZ_ROLE_MAP_JSON={"administrator":"admin","operator":"operator","auditor":"viewer"}
CSRF_SECRET=replace-with-a-long-random-value
# Optional dedicated session signing secret. If omitted, CSRF_SECRET signs sessions.
# AUTH_SESSION_SECRET=replace-with-a-different-long-random-value
# Session duration in milliseconds (default: 28800000 / 8 hours).
# AUTH_SESSION_TTL_MS=28800000
# Docker Compose only: stable internal network shared with the reverse proxy.
CRONTAB_UI_NETWORK=crontab-ui-internal
# In production all authenticated users must be represented in AUTHZ_ROLE_MAP_JSON.
# JSON object keyed by profile ID. Credentials remain server-side.
MAIL_PROFILES_JSON={"operations":{"transporter":"smtps://user:password@smtp.example.com","from":"crontab@example.com","to":"operations@example.com"}}
# Maximum bytes per stdout/stderr attachment (1-10485760); recipients are fixed in the profile.
MAIL_MAX_ATTACHMENT_BYTES=524288
COMMAND_TIMEOUT_MS=300000
COMMAND_MAX_BUFFER=1048576
COMMAND_KILL_GRACE_MS=5000
LOG_MAX_BYTES=10485760
LOG_ROTATION_COUNT=5
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_RETENTION_DAYS=90
# Bounds the `crontab -l` read used by "Get from crontab"; the import is serialised with backup/restore.
SYSTEM_CRONTAB_IMPORT_TIMEOUT_MS=30000
SYSTEM_CRONTAB_IMPORT_MAX_BUFFER=262144
# Only these UI-managed values are passed into task processes. Process credentials and
# unsafe loader variables are never inherited. Add only reviewed task variables.
TASK_ENV_ALLOWLIST=PATH,LANG,LC_ALL,TZ,MAILTO
# Operators can create and execute arbitrary task commands only when this is explicitly true.
# Leave false until task processes and their accessible files are effectively isolated.
ALLOW_OPERATOR_TASK_EXECUTION=false
# Environment entries managed through the UI must be uppercase NAME=value lines only.
